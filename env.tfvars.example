# =====================================================================
# Common Configuration
# =====================================================================

# Prefix for resource naming (e.g., your username or environment name)
prefix = "myusername"

# Azure region for deployment
location = "centralus"

# Owner email for resource tagging
email = "myusername@example.com"

# Date when resources should be removed (for tagging)
remove_date = "2026-12-31"

# Description for resource tagging
description = "Databricks Private Link with Unity Catalog and NCC"

# =====================================================================
# Azure & Databricks Account Configuration
# =====================================================================

# Your Azure subscription ID
subscription_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Your Databricks account console ID
# Find this at: https://accounts.azuredatabricks.net/ (in the URL after /accounts/)
databricks_account_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# =====================================================================
# Networking Configuration
# =====================================================================

# CIDR block for the virtual network
cidr = "10.0.0.0/20"

# Optional: Service endpoints for the private subnet
# private_subnet_endpoints = ["Microsoft.Storage", "Microsoft.KeyVault"]

# =====================================================================
# Unity Catalog Configuration
# =====================================================================

# Name for the Unity Catalog metastore
uc_metastore_name = "myusername-centralus-mts"

# =====================================================================
# Network Connectivity Config (NCC) Configuration
# =====================================================================

# Whether to enable NCC for storage
enable_ncc = true

# Storage endpoint type: "dfs" for ADLS Gen2, "blob" for Blob Storage
storage_group_id = "dfs"
