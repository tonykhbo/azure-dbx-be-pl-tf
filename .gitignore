# =====================================================================
# Terraform
# =====================================================================

# Local .terraform working directories
**/.terraform/
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Terraform plan files
*.tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock files
.terraform.lock.hcl

# =====================================================================
# Environment & Secrets
# =====================================================================

# Terraform variable files (contain sensitive values)
*.tfvars
*.tfvars.json

# .env files
.env
.env.*
!.env.example
!*.env.example

# =====================================================================
# OS & Editor
# =====================================================================

.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
